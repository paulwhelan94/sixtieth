<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#07111f">
  <title>Dad's 60th Birthday Surprise</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--gold:#fbbf24;--ink:#07111f;--panel:rgba(15,23,42,.76)}
    *{box-sizing:border-box}
    html,body{height:100%;margin:0}
    body{font-family:"Plus Jakarta Sans",sans-serif;background:#07111f;color:#f8fafc;overflow:hidden;touch-action:manipulation}
    .serif{font-family:Cinzel,serif}.gold{background:linear-gradient(120deg,#fff1a6,#fbbf24 45%,#fb923c);-webkit-background-clip:text;color:transparent}
    .glass{background:var(--panel);border:1px solid rgba(255,255,255,.13);box-shadow:0 28px 80px rgba(0,0,0,.45);backdrop-filter:blur(18px)}
    .scene{position:absolute;inset:0;display:grid;place-items:center;padding:6.5rem 1.25rem 7rem;opacity:0;visibility:hidden;transform:translateY(24px) scale(.98);transition:.7s cubic-bezier(.16,1,.3,1)}
    .scene.active{opacity:1;visibility:visible;transform:none}.scene.leaving{transform:translateY(-20px) scale(.98)}
    .destination-black{background:#000!important;z-index:20}
    .orb{position:absolute;border-radius:999px;filter:blur(75px);opacity:.22;animation:drift 9s ease-in-out infinite alternate}
    @keyframes drift{to{transform:translate3d(25px,-24px,0) scale(1.12)}}
    @keyframes breathe{50%{transform:scale(1.035);box-shadow:0 0 45px rgba(251,191,36,.28)}}
    .primary{animation:breathe 2.4s ease-in-out infinite}.reveal{opacity:0;transform:translateY(14px);transition:.8s ease}.reveal.show{opacity:1;transform:none}
    .photo{transition:opacity .3s ease,transform .55s ease}.photo.loading{opacity:0;transform:scale(1.025)}
    .kenburns{animation:ken 7s ease-out both}@keyframes ken{from{transform:scale(1.06)}to{transform:scale(1)}}
    .safe-top{padding-top:max(1rem,env(safe-area-inset-top))}.safe-bottom{padding-bottom:max(1rem,env(safe-area-inset-bottom))}
    @media (prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
    @media (max-height:700px){.scene{padding-top:5rem;padding-bottom:5.5rem}.compact{max-height:70vh}}
  </style>
</head>
<body>
  <div aria-hidden="true" class="fixed inset-0 overflow-hidden">
    <div class="orb -left-32 -top-32 h-96 w-96 bg-amber-400"></div><div class="orb -right-40 top-1/3 h-[30rem] w-[30rem] bg-indigo-500" style="animation-delay:-3s"></div><div class="orb bottom-[-12rem] left-1/3 h-96 w-96 bg-sky-500" style="animation-delay:-6s"></div>
  </div>

  <header class="safe-top fixed inset-x-0 top-0 z-50 flex items-center justify-between px-4 md:px-8">
    <div class="glass flex items-center gap-3 rounded-full px-4 py-2"><span id="stepLabel" class="text-xs font-bold uppercase tracking-[.2em] text-slate-400">The surprise</span><div id="dots" class="flex gap-1.5"></div></div>
    <div class="flex gap-2">
      <button id="restart" class="glass rounded-full p-3 text-slate-300" aria-label="Start again"><i data-lucide="rotate-ccw" class="h-5 w-5"></i></button>
    </div>
  </header>

  <main id="stage" aria-live="polite">
    <section class="scene active" data-title="Happy 60th">
      <div class="glass w-full max-w-3xl rounded-[2rem] p-7 text-center md:p-14">
        <div class="mx-auto mb-6 grid h-16 w-16 place-items-center rounded-2xl border border-amber-400/30 bg-amber-400/10"><i data-lucide="gift" class="h-9 w-9 text-amber-300"></i></div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[.28em] text-amber-300">A little early...</p>
        <h1 class="serif gold text-5xl font-black leading-tight md:text-7xl">Dad, your 60th starts here</h1>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-300 md:text-xl">Your birthday is still a while away, but this surprise is too exciting to keep until next year.</p>
        <button id="celebrate" class="mt-7 rounded-xl border border-amber-400/30 bg-amber-400/10 px-5 py-3 font-bold text-amber-200">A little more confetti</button>
      </div>
    </section>

    <section class="scene" data-title="The plan"><div class="glass w-full max-w-3xl rounded-[2rem] p-8 text-center md:p-14"><h2 class="serif text-4xl font-bold md:text-6xl">For your 60th...</h2><p class="gold inline-block mt-5 px-1 pb-2 text-3xl font-extrabold leading-[1.25] md:text-5xl">you're going on a trip.</p></div></section>

    <section class="scene" data-title="When"><div class="glass w-full max-w-3xl rounded-[2rem] p-8 text-center md:p-14"><i data-lucide="calendar-days" class="mx-auto mb-6 h-14 w-14 text-emerald-300"></i><p class="text-sm font-bold uppercase tracking-[.28em] text-emerald-300">Save the dates</p><h2 class="serif mt-4 text-3xl text-slate-300">When?</h2><div class="my-7 rounded-2xl border border-emerald-400/30 bg-slate-950/60 p-6"><p class="serif text-4xl font-black text-emerald-300 md:text-6xl">26–29 March 2027</p></div><p id="offWork" class="reveal flex items-center justify-center gap-2 text-lg font-semibold text-amber-200"><i data-lucide="circle-check" class="h-5 w-5 text-emerald-300"></i>And yes, you're off work.</p></div></section>

    <section class="scene" data-title="The gang"><div class="glass w-full max-w-3xl rounded-[2rem] p-8 text-center md:p-14"><i data-lucide="users" class="mx-auto mb-6 h-14 w-14 text-violet-300"></i><h2 class="serif text-4xl md:text-5xl">Who with?</h2><p id="groupOne" class="reveal mt-8 text-2xl font-bold md:text-4xl">Mum, Paul, Steph, Lynsey &amp; Lewis</p><p id="groupTwo" class="reveal gold mt-6 px-1 pb-2 text-3xl font-black leading-[1.25] md:text-5xl">...and your grandson 👶</p></div></section>

    <section class="scene" data-title="The mystery"><div class="text-center"><p id="where" class="serif text-6xl font-black md:text-8xl">Where<span id="ellipsis" class="text-amber-300"></span><span id="question" class="text-amber-300 opacity-0">?</span></p></div></section>

    <section class="scene" data-title="First leg"><div class="glass compact w-full max-w-4xl overflow-y-auto rounded-[2rem] p-4 text-center md:p-7"><p class="mb-3 font-bold text-amber-200">Friday, 26 March 2027</p><h2 class="serif text-2xl font-bold md:text-4xl">First, everyone meets in Fort William</h2><div class="relative mx-auto mt-4 h-[42vh] min-h-[260px] max-w-2xl overflow-hidden rounded-2xl border border-white/10 bg-[#71BDEE]"><img src="Designer3.png" alt="Map showing everyone's first leg to Fort William" class="h-full w-full object-contain"></div><div class="mt-4 flex flex-wrap justify-center gap-4 text-sm font-semibold"><span class="text-amber-300">● You &amp; Mum</span><span class="text-sky-300">● Steph &amp; Lewis</span><span class="text-rose-300">● Paul, Lynsey &amp; Pops</span></div></div></section>

    <section class="scene" data-title="Second leg"><div class="glass compact w-full max-w-4xl overflow-y-auto rounded-[2rem] p-4 text-center md:p-7"><p class="mb-3 font-bold text-amber-200">Saturday, 27 March 2027</p><h2 class="serif mt-2 text-3xl font-bold md:text-3xl">The next morning, we all make our way to the destination</h2><div class="relative mx-auto mt-4 h-[48vh] min-h-[280px] max-w-2xl overflow-hidden rounded-2xl border border-white/10 bg-[#71BDEE]"><img src="Designer.png" alt="Map showing the second leg of the journey" class="h-full w-full object-contain"><div class="absolute bottom-3 right-3 rounded-xl bg-slate-950/90 px-4 py-2 text-sm font-bold text-violet-200">All of us, together</div></div></div></section>

    <section class="scene destination-black" data-title="Destination"><div id="goingTo" class="reveal absolute inset-0 grid place-items-center bg-black text-center"><p class="serif px-5 text-4xl text-slate-200 md:text-6xl">We're all going to...</p></div><div id="destination" class="reveal relative z-10 text-center"><h2 class="serif gold inline-block px-2 pb-3 text-6xl font-black leading-[1.15] tracking-wider md:text-9xl">RAASAY</h2></div></section>

    <section class="scene" data-title="Where we'll stay"><div class="glass compact w-full max-w-4xl overflow-y-auto rounded-[2rem] p-4 text-center md:p-7"><p class="text-xs font-bold uppercase tracking-[.28em] text-amber-300">Where we're staying</p><h2 class="serif mt-2 text-2xl font-bold md:text-4xl">Na Bothain &amp; Raasay Distillery</h2><div class="relative mx-auto mt-4 h-[48vh] min-h-[280px] max-w-3xl overflow-hidden rounded-2xl bg-slate-950"><img id="galleryPhoto" class="photo h-full w-full object-cover" alt="Accommodation"><div class="absolute inset-x-0 bottom-0 flex items-end justify-between bg-gradient-to-t from-black/90 to-transparent p-5"><p id="caption" class="max-w-[75%] text-left font-semibold"></p><span id="counter" class="rounded-full bg-black/60 px-3 py-1 text-xs text-amber-200"></span></div><button id="photoPrev" class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full bg-black/65 p-3" aria-label="Previous photo"><i data-lucide="chevron-left"></i></button><button id="photoNext" class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full bg-black/65 p-3" aria-label="Next photo"><i data-lucide="chevron-right"></i></button></div></div></section>
  </main>

  <footer class="safe-bottom fixed inset-x-0 bottom-0 z-50 flex items-center justify-between px-4 md:px-8"><button id="back" class="glass rounded-2xl px-5 py-4 font-bold disabled:opacity-20"><span class="flex gap-2"><i data-lucide="chevron-left"></i><span class="hidden sm:inline">Back</span></span></button><button id="next" class="primary rounded-2xl bg-gradient-to-r from-amber-400 to-orange-500 px-7 py-4 font-extrabold text-slate-950 shadow-xl"><span class="flex items-center gap-3"><span id="nextText">Begin the surprise</span><i data-lucide="arrow-right"></i></span></button></footer>

<script>
const scenes=[...document.querySelectorAll('.scene')];
let step=0,timers=[],photo=0,auto=null,canContinue=false,maxUnlockedStep=0,touchStartX=0;
const photos=[
['raasay-distillery-luxury-accommodation-na-bothain-gallery-1.jpg','Na Bothain: luxury timber eco cabins'],
['raasay-distillery-luxury-accommodation-view.jpg','Views across the Sound of Raasay to Skye'],
['raasay-distillery-accommodation-na-bothain.jpg','A room with a remarkable view'],
['raasay-distillery-accommodation-na-bothain-3.jpg','Warm, modern timber interiors'],
['raasay-distillery-accommodation-na-bothain-4.jpg','A bath overlooking loch and mountains'],
['raasay-distillery-accommodation-na-bothain-6.jpg','A dram of Isle of Raasay single malt'],
['raasay-distillery-accommodation-na-bothain-7.jpg','A little luxury after exploring'],
['raasay-distillery-accommodation-na-bothain-8.jpg','Space to relax together']];
const $=id=>document.getElementById(id);
const later=(fn,ms)=>timers.push(setTimeout(fn,ms));
function clearTimers(){timers.forEach(clearTimeout);timers=[];clearInterval(auto);auto=null;}
function unlock(){
  canContinue=true;
  maxUnlockedStep=Math.max(maxUnlockedStep,Math.min(step+1,scenes.length-1));
  const b=$('next');
  if(step<scenes.length-1){b.disabled=false;b.style.opacity='1';b.style.pointerEvents='auto';}
}
function lock(delay){
  canContinue=false;
  const b=$('next');
  b.disabled=true;b.style.opacity='.28';b.style.pointerEvents='none';
  later(unlock,delay);
}
function dots(){
  $('dots').innerHTML=scenes.map((_,i)=>`<button aria-label="Go to part ${i+1}" data-step="${i}" ${i>maxUnlockedStep?'disabled':''} class="h-2 rounded-full transition-all ${i===step?'w-6 bg-amber-300':i<step?'w-2 bg-slate-400':'w-2 bg-slate-700'} ${i>maxUnlockedStep?'cursor-not-allowed opacity-40':''}"></button>`).join('');
  document.querySelectorAll('[data-step]').forEach(b=>b.onclick=()=>{const n=+b.dataset.step;if(n<=maxUnlockedStep)show(n)});
}
function resetReveals(){document.querySelectorAll('.reveal').forEach(x=>x.classList.remove('show'));$('ellipsis').textContent='';$('question').style.opacity=0;}
function show(n){
  clearTimers();
  if(n>maxUnlockedStep)return;
  step=Math.max(0,Math.min(scenes.length-1,n));
  scenes.forEach((s,i)=>{s.classList.toggle('active',i===step);s.classList.toggle('leaving',i<step)});
  resetReveals();dots();
  $('stepLabel').textContent=scenes[step].dataset.title;
  $('back').disabled=step===0;
  const labels=['Begin the surprise','When?','Who is coming?','But where?','Show the first leg','Show the second leg','Reveal the destination','See where we’re staying'];
  $('nextText').textContent=labels[step]||'Continue';
  $('next').style.visibility=step===scenes.length-1?'hidden':'visible';
  document.body.style.backgroundColor=(step===4||step===7)?'#000000':'#07111f';

  let delay=1500;
  if(step===2){delay=2500;later(()=>$('offWork').classList.add('show'),1500)}
  if(step===3){delay=2800;later(()=>$('groupOne').classList.add('show'),500);later(()=>$('groupTwo').classList.add('show'),1900)}
  if(step===4){delay=3300;[1,2,3].forEach((v,i)=>later(()=>$('ellipsis').textContent='.'.repeat(v),700+i*600));later(()=>$('question').style.opacity=1,2600)}
  if(step===7){delay=4300;later(()=>$('goingTo').classList.add('show'),400);later(()=>$('goingTo').classList.remove('show'),2300);later(()=>$('destination').classList.add('show'),3100)}
  if(step===8){renderPhoto();auto=setInterval(()=>changePhoto(1),4500)}
  if(step<scenes.length-1)lock(delay); else canContinue=false;
}
function renderPhoto(){const im=$('galleryPhoto');im.classList.add('loading');later(()=>{im.src=photos[photo][0];im.alt=photos[photo][1];$('caption').textContent=photos[photo][1];$('counter').textContent=`${photo+1} / ${photos.length}`;im.classList.remove('loading');im.classList.remove('kenburns');void im.offsetWidth;im.classList.add('kenburns')},180)}
function changePhoto(d){photo=(photo+d+photos.length)%photos.length;renderPhoto();}
function next(){if(canContinue&&step<scenes.length-1)show(step+1)}
$('next').onclick=next;
$('back').onclick=()=>show(step-1);
$('restart').onclick=()=>{maxUnlockedStep=0;photo=0;show(0)};
$('celebrate').onclick=()=>{if(window.confetti)confetti({particleCount:110,spread:85,origin:{y:.65},colors:['#fbbf24','#38bdf8','#a78bfa','#34d399','#fb7185']})};
$('photoPrev').onclick=()=>changePhoto(-1);$('photoNext').onclick=()=>changePhoto(1);
document.addEventListener('keydown',e=>{if(['ArrowRight',' ','Enter'].includes(e.key)){e.preventDefault();next()}if(e.key==='ArrowLeft'&&step>0)show(step-1)});
document.addEventListener('touchstart',e=>touchStartX=e.changedTouches[0].clientX,{passive:true});
document.addEventListener('touchend',e=>{const d=e.changedTouches[0].clientX-touchStartX;if(d<-70)next();else if(d>70&&step>0)show(step-1)},{passive:true});
lucide.createIcons();show(0);later(()=>{if(window.confetti)confetti({particleCount:110,spread:85,origin:{y:.65}})},450);
</script>
</body></html>
